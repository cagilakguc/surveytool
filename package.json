{
  "name": "surveytool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predev": "node scripts/build-crs-catalogue.mjs",
    "prebuild": "node scripts/build-crs-catalogue.mjs",
    "test:maps": "node --import tsx scripts/validate-survey-maps.mjs",
    "test:crs": "node --import tsx scripts/validate-crs-selection.mjs",
    "test:datum": "node --import tsx scripts/validate-datum-operations.mjs",
    "test:asbuilt": "node --import tsx scripts/validate-asbuilt.mjs",
    "test:sections": "node --import tsx scripts/validate-sections.mjs",
    "postbuild": "node scripts/generate-service-worker.mjs",
    "test:terrain": "node --import tsx scripts/validate-terrain.mjs",
    "test:offline": "node --import tsx scripts/validate-offline.mjs",
    "test:viewer": "node --import tsx scripts/validate-landxml-display.mjs",
    "test:usage": "node --import tsx scripts/validate-tool-usage.mjs",
    "test:gis-columns": "node --import tsx scripts/validate-gis-columns.mjs",
    "test:pavement": "node --import tsx scripts/validate-pavement-design.mjs",
    "test:pavement-workspace": "node --import tsx scripts/validate-pavement-workspace.mjs",
    "test:pavement-bottom": "node --import tsx scripts/validate-pavement-bottom-surface.mjs",
    "test:tin-boundaries": "node --import tsx scripts/validate-tin-boundaries.mjs",
    "test:pavement-thickness": "node --import tsx scripts/validate-pavement-thickness.mjs",
    "test:pavement-slopes": "node --import tsx scripts/validate-pavement-slopes.mjs",
    "test:jxl": "node --import tsx scripts/validate-jobxml.mjs",
    "test:dbx": "node --import tsx scripts/validate-dbx.mjs",
    "test:network": "node --import tsx scripts/validate-network-adjustment.mjs",
    "test:starnet": "node --import tsx scripts/validate-starnet-import.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@vercel/analytics": "^2.0.1",
    "cdt2d": "^1.0.0",
    "earcut": "^3.2.4",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "^1.23.0",
    "ol": "^10.11.0",
    "ol-mapbox-style": "^13.8.0",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "robust-segment-intersect": "^1.0.1",
    "stripe": "^22.3.1",
    "three": "^0.187.0",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vercel/node": "^5.8.23",
    "@vitejs/plugin-react": "^6.0.3",
    "epsg-index": "^2.0.0",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.71.0",
    "sql.js": "1.14.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
